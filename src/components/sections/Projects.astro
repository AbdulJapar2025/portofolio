---
const projects = [
  {
    title: 'STTI Career - Job Portal',
    description: 'Sangat bangga bisa membagikan hasil kolaborasi intensif bersama tim pengembang dalam membangun STTI Career, sebuah platform fullstack yang dirancang untuk menyederhanakan ekosistem rekrutmen. Aplikasi ini lahir dari pengamatan kami terhadap tantangan yang dihadapi rekan mahasiswa dalam mencari peluang karier dan tantangan HR dalam mengelola pipeline pelamar secara efisien.',
    tech: ['Laravel', 'React', 'MySQL', 'Tailwind CSS', 'REST API'],
    github: 'https://github.com/AbdulJapar2025/jobportal',
    demo: '#',
    image: 'jobportal.jpg',
  },
  {
    title: 'SIAKAD - Sistem Informasi Akademik',
    description: 'Mengatasi permasalahan ketidakefisienan dan mininya transparansi pada sistem akademik lama dengan membangun SIAKAD berbasis web yang modern dan terintegrasi. Proyek ini mencakup pengelolaan data utama (nilai, presensi, keuangan dan lainnya), penyederhanaan alur KRS/KHS, serta integrasi end-to-end dengan Midtrans untuk transparansi pembayaran dan Moodle (LMS/ELMA) untuk proses pembelajaran yang terpusat.',
    tech: ['PHP', 'MySQL', 'Docker', 'Tailwind CSS', 'TailAdmin', 'Alpine.js', 'Midtrans', 'Moodle'],
    github: 'https://github.com/AbdulJapar2025/siakad',
    demo: '#',
    image: 'siakad.png',
  },
];
---

<section id="portfolio" class="py-20">
  <div class="container mx-auto px-6 max-w-5xl">
    <p class="text-sm text-primary font-semibold mb-3">Portfolio</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-10">Project</h2>

    <div class="grid sm:grid-cols-2 gap-5">
      {projects.map((project) => (
        <div class="group p-5 rounded-xl bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200">
          <!-- Thumbnail -->
          <img
            src={`${import.meta.env.BASE_URL}/images/${project.image}`}
            alt={project.title}
            class="w-full h-36 object-cover rounded-lg mb-4"
          />

          <!-- Content -->
          <h3 class="font-bold mb-2 group-hover:text-primary transition-colors">{project.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4">{project.description}</p>

          <!-- Tech Stack -->
          <div class="flex flex-wrap gap-2 mb-5">
            {project.tech.map((t) => (
              <span class="px-3 py-1.5 rounded-lg border border-border text-sm text-muted-foreground">
                {t}
              </span>
            ))}
          </div>

          <!-- Links -->
          <div class="flex items-center gap-4 text-sm">
            <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              Source Code
            </a>
            <a href={project.demo} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" x2="21" y1="14" y2="3"></line>
              </svg>
              Live Demo
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
