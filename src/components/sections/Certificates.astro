---
const base = import.meta.env.BASE_URL;
---

<section id="sertifikat" class="py-20">
  <div class="container mx-auto px-6 max-w-5xl">
    <p class="text-sm text-primary font-semibold mb-3">Sertifikasi</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-10">Sertifikat</h2>

    <div class="max-w-sm">
      <div class="p-5 rounded-xl bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200">
        <!-- Thumbnail -->
        <button
          id="cert-preview-btn"
          class="block w-full h-48 rounded-lg bg-secondary border border-border mb-4 overflow-hidden hover:opacity-80 transition-opacity cursor-pointer"
        >
          <img src={`${base}/images/bnsp1.png`} alt="BNSP Web Development" class="w-full h-full object-cover" />
        </button>

        <!-- Content -->
        <h3 class="font-bold text-sm mb-1.5">BNSP Web Development</h3>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span>BNSP</span>
          <span>·</span>
          <span>2024</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modal Preview -->
<div id="cert-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="relative max-w-4xl w-full bg-background rounded-2xl border border-border overflow-hidden">
    <button id="cert-modal-close" class="absolute top-3 right-3 z-10 p-2 rounded-lg bg-background/80 backdrop-blur-sm border border-border text-muted-foreground hover:text-foreground transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
    <div class="p-6">
      <h3 class="font-bold text-lg mb-4">BNSP Web Development</h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <img src={`${base}/images/bnsp1.png`} alt="BNSP Web Development - Halaman 1" class="w-full rounded-lg border border-border" />
        <img src={`${base}/images/bnsp2.png`} alt="BNSP Web Development - Halaman 2" class="w-full rounded-lg border border-border" />
      </div>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('cert-preview-btn');
  const modal = document.getElementById('cert-modal');
  const closeBtn = document.getElementById('cert-modal-close');

  btn?.addEventListener('click', () => modal?.classList.remove('hidden'));
  closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });
</script>
