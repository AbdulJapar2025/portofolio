---
const base = import.meta.env.BASE_URL;

const contactInfo = [
  {
    icon: 'email',
    label: 'Email',
    value: 'your@email.com',
    href: 'mailto:your@email.com',
  },
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: '+62 xxx-xxxx-xxxx',
    href: 'https://wa.me/62xxxxxxxxxxx',
  },
  {
    icon: 'github',
    label: 'GitHub',
    value: 'github.com/AbdulJapar2025',
    href: 'https://github.com/AbdulJapar2025',
  },
  {
    icon: 'linkedin',
    label: 'LinkedIn',
    value: 'linkedin.com/in/yourusername',
    href: 'https://linkedin.com',
  },
];
---

<section id="kontak" class="py-20">
  <div class="container mx-auto px-6 max-w-5xl">
    <p class="text-sm text-primary font-semibold mb-3">Kontak</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Mari Terhubung</h2>
    <p class="text-muted-foreground mb-10 max-w-lg">
      Saya selalu terbuka untuk kolaborasi, diskusi proyek, atau peluang profesional baru. Jangan ragu untuk menghubungi saya melalui salah satu media di bawah ini.
    </p>

    <div class="grid sm:grid-cols-2 gap-4 max-w-2xl">
      {contactInfo.map((contact) => (
        <a
          href={contact.href}
          target={contact.icon !== 'email' ? '_blank' : undefined}
          rel={contact.icon !== 'email' ? 'noopener noreferrer' : undefined}
          class="flex items-center gap-4 p-4 rounded-xl bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group"
        >
          <div class="p-3 rounded-lg bg-secondary border border-border group-hover:border-primary/30 transition-colors">
            {contact.icon === 'email' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary transition-colors">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            )}
            {contact.icon === 'whatsapp' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary transition-colors">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            )}
            {contact.icon === 'github' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary transition-colors">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
            )}
            {contact.icon === 'linkedin' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary transition-colors">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            )}
          </div>
          <div>
            <p class="text-sm font-medium">{contact.label}</p>
            <p class="text-xs text-muted-foreground">{contact.value}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
