---
const base = import.meta.env.BASE_URL;

const contacts = [
  {
    label: 'Email',
    value: 'your@email.com',
    href: 'mailto:your@email.com',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>`,
  },
  {
    label: 'GitHub',
    value: 'AbdulJapar2025',
    href: 'https://github.com/AbdulJapar2025',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>`,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/abdul-japar-sidik',
    href: 'https://www.linkedin.com/in/abdul-japar-sidik/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>`,
  },
  {
    label: 'WhatsApp',
    value: '+62 xxx-xxxx-xxxx',
    href: 'https://wa.me/62xxxxxxxxxxx',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>`,
  },
];
---

<section id="kontak" class="py-20">
  <div class="container mx-auto px-6 max-w-5xl">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Left: Info -->
      <div>
        <p class="text-sm text-primary font-semibold mb-3">Kontak</p>
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Mari Terhubung</h2>
        <p class="text-muted-foreground leading-relaxed mb-8">
          Saya selalu terbuka untuk kolaborasi, diskusi proyek, atau peluang profesional baru. Jangan ragu untuk menghubungi saya melalui channel di bawah.
        </p>

        <div class="space-y-4">
          {contacts.map((c) => (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 p-4 rounded-xl bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200"
            >
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center" set:html={c.icon} />
              <div class="min-w-0">
                <p class="text-xs text-muted-foreground mb-0.5">{c.label}</p>
                <p class="text-sm font-medium truncate group-hover:text-primary transition-colors">{c.value}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: Form -->
      <div class="p-6 rounded-2xl bg-card border border-border">
        <h3 class="font-bold text-lg mb-1">Kirim Pesan</h3>
        <p class="text-sm text-muted-foreground mb-6">Isi form di bawah, saya akan balas secepatnya.</p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="text-sm font-medium mb-1.5 block">Nama</label>
            <input
              type="text"
              id="name"
              placeholder="Nama lengkap"
              class="w-full px-3 py-2 rounded-lg border border-border bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
            />
          </div>
          <div>
            <label for="email" class="text-sm font-medium mb-1.5 block">Email</label>
            <input
              type="email"
              id="email"
              placeholder="email@contoh.com"
              class="w-full px-3 py-2 rounded-lg border border-border bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
            />
          </div>
          <div>
            <label for="message" class="text-sm font-medium mb-1.5 block">Pesan</label>
            <textarea
              id="message"
              rows="4"
              placeholder="Tulis pesan kamu..."
              class="w-full px-3 py-2 rounded-lg border border-border bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-primary-foreground text-sm font-semibold hover:bg-primary/90 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m22 2-7 20-4-9-9-4Z"></path>
              <path d="M22 2 11 13"></path>
            </svg>
            Kirim
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value;
    const text = `Halo, saya ${name} (${email}). ${message}`;
    window.location.href = `mailto:your@email.com?subject=Pesan dari ${name}&body=${encodeURIComponent(text)}`;
  });
</script>
